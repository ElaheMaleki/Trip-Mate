<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/gradient_background">


    <EditText
        android:id="@+id/etNewTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:hint="کار جدید را وارد کنید"
        android:inputType="text"
         />

    <Button
        android:id="@+id/btnAddTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#409376"
        android:fontFamily="@font/vazirmatn"
        android:text="افزودن کار"
        android:layout_marginTop="8dp" />


    <ListView
        android:id="@+id/lvTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:paddingTop="8dp"
        android:fontFamily="@font/vazirmatn"
        android:textColor="#000000"
        />

    <Button
        android:id="@+id/btnShowSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#409376"
        android:text="مشاهده لیست سفر ها"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/vazirmatn" />

</LinearLayout>
