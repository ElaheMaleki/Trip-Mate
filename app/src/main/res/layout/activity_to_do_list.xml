<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/gradient_background"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <EditText
        android:id="@+id/etNewTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:hint="وسایل مورد نیاز را وارد کنید"
        android:inputType="text"
        android:textColor="#0B2A1C"
        android:textColorHint="#496457"
         />

    <Button
        android:id="@+id/btnAddTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#409376"
        android:fontFamily="@font/vazirmatn"
        android:text="افزودن کار"
        android:layout_marginTop="8dp" />


    <ListView
        android:id="@+id/lvTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:paddingTop="8dp"
        android:fontFamily="@font/vazirmatn"
        android:textColor="#000000"
        />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">



            <Button
                android:id="@+id/btnalarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#409376"
                android:fontFamily="@font/vazirmatn"
                app:cornerRadius="8dp"
                android:text="تنظیم آلارم" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnShowSummary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#409376"
                android:fontFamily="@font/vazirmatn"
                app:cornerRadius="10dp"
                android:text="مشاهده لیست سفر ها"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
